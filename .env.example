NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico
ADMIN_EMAIL=administrador@exemplo.com

# UUID do mesmo usuário cadastrado na migração de RLS; obrigatório.
ADMIN_USER_ID=
# Webhook HTTPS para alertas operacionais (opcional, somente no servidor).
ALERT_WEBHOOK_URL=
# Resend: quando os três valores estão definidos, o e-mail substitui o webhook.
# Chave somente no servidor. Remetente de domínio verificado em produção.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Segredo para a consulta externa de saúde; nunca NEXT_PUBLIC.
MONITOR_TOKEN=
